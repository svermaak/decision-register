# Copy this file to .env and fill in the values. Never commit .env.
# This is a draft. The names may change while the system is being built.

# local = no sign-in, own machine only. team = Entra ID sign-in.
APP_MODE=local

# Folder for the database, the search index and stored files.
DATA_DIR=

# Where the encryption key comes from: keyring (local), aws or azure.
KEY_SOURCE=keyring
KEY_NAME=

# Team mode only: Entra ID sign-in.
PUBLIC_URL=
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
FIRST_ADMIN=

# Confluence Cloud publishing and reading. Put the API token in the secret store, not here.
CONFLUENCE_BASE_URL=
CONFLUENCE_USER=
CONFLUENCE_PUBLISH_SPACE=
CONFLUENCE_ALLOWED_SPACES=
